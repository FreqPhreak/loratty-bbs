import json
from pathlib import Path

class Storage:
    def __init__(self, path="bbs_store.json"):
        self.path = Path(path)
        if not self.path.exists():
            self.path.write_text("[]")

    def save(self, msg):
        data = json.loads(self.path.read_text())
        data.append(msg)
        self.path.write_text(json.dumps(data))